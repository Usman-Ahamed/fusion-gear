# Copy to .env.local for local development.
# On Vercel, set these in Project → Settings → Environment Variables.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/fusion-gear?retryWrites=true&w=majority

# Long random string used to sign admin sessions (32+ characters).
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Cloudinary (review photo storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public site URL, no trailing slash
NEXT_PUBLIC_SITE_URL=https://reviews.fusiongear.lk

# WhatsApp number: country code + number, no + or spaces (e.g. 94771234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: link to your Google Business reviews (shown next to the Google rating)
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=

# Optional but recommended: Cloudflare Turnstile spam protection for the review form.
# Create a widget at https://dash.cloudflare.com → Turnstile. If unset, only the honeypot + rate limit apply.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: Verified buyer badge. Read-only WooCommerce REST API key for fusiongear.lk
# (WordPress admin → WooCommerce → Settings → Advanced → REST API → Add key, permission: Read)
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# Only needed when running `npm run seed` to create the admin or reset its password.
# Remove ADMIN_PASSWORD again afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
